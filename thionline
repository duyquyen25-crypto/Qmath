        function parseQuizFile(text) {
             const lines = text.split(/[\r\n]+/);
             let questions = [];
             let currentQ = null;

             for (let i = 0; i < lines.length; i++) {
                  let line = lines[i].trim();
                  if (!line) continue;

                  if (line.toLowerCase().startsWith("câu hỏi:") || line.toLowerCase().startsWith("câu ")) {
                       if (currentQ && currentQ.options.length > 0 && currentQ.answer !== -1) {
                            questions.push(currentQ);
                       }
                       currentQ = {
                            id: questions.length + 1,
                            part: 1,
                            type: 'mcq',
                            text: line.replace(/^(câu hỏi:|câu \d+:)/i, '').trim(),
                            options: [],
                            answer: -1
                       };
                  } else if (line.toLowerCase().startsWith("đáp án:") && currentQ) {
                       currentQ.options.push(line.substring(7).trim());
                  } else if (line.toLowerCase().startsWith("đúng:") && currentQ) {
                       const val = parseInt(line.substring(5).trim());
                       if (!isNaN(val)) currentQ.answer = val;
                  }
             }
             if (currentQ && currentQ.options.length > 0 && currentQ.answer !== -1) {
                  questions.push(currentQ);
             }
             return questions;
        }

        function parseLatexQuizFile(text) {
             text = text.replace(/%.*$/gm, '');
             let questions = [];
             let globalQIndex = 1;

             if (text.includes('\\begin{ex}')) {
                 let p1Idx = text.search(/(PHẦN I|PHẦN 1|\\part\{1\})/i);
                 let p2Idx = text.search(/(PHẦN II|PHẦN 2|\\part\{2\})/i);
                 let p3Idx = text.search(/(PHẦN III|PHẦN 3|\\part\{3\})/i);
                 
                 if (p1Idx === -1) p1Idx = 0;
                 if (p2Idx === -1) p2Idx = text.length;
                 if (p3Idx === -1) p3Idx = text.length;

                 const exRegex = /\\begin\{ex\}([\s\S]*?)\\end\{ex\}/gi;
                 let match;
                 
                 while ((match = exRegex.exec(text)) !== null) {
                     let blockIndex = match.index;
                     let blockContent = match[1];
                     
                     let part = 1;
                     if (p3Idx !== text.length && blockIndex > p3Idx) part = 3;
                     else if (p2Idx !== text.length && blockIndex > p2Idx) part = 2;

                     const extractBraceGroups = (str, startIdx, count) => {
                         let groups = [];
                         let curr = startIdx;
                         for (let i = 0; i < count; i++) {
                             let openIdx = str.indexOf('{', curr);
                             if (openIdx === -1) break;
                             let depth = 1;
                             let closeIdx = -1;
                             for (let j = openIdx + 1; j < str.length; j++) {
                                 if (str[j] === '{') depth++;
                                 else if (str[j] === '}') {
                                     depth--;
                                     if (depth === 0) { closeIdx = j; break; }
                                 }
                             }
                             if (closeIdx !== -1) {
                                 groups.push(str.substring(openIdx + 1, closeIdx).trim());
                                 curr = closeIdx + 1;
                             } else {
                                 break;
                             }
                         }
                         return groups;
                     };

                     let loigiaiMatch = blockContent.indexOf('\\loigiai');
                     let qContent = blockContent;
                     if (loigiaiMatch !== -1) {
                         qContent = blockContent.substring(0, loigiaiMatch);
                     }

                     let choiceTFMatch = qContent.match(/\\choiceTFt|\\choiceTF/);
                     let choiceMatch = qContent.match(/\\choice\b/);
                     
                     if (choiceTFMatch) {
                         let keywordIdx = choiceTFMatch.index;
                         let textPart = qContent.substring(0, keywordIdx).trim();
                         let groups = extractBraceGroups(qContent, keywordIdx, 4);
                         
                         if (groups.length === 4) {
                             let statements = groups.map(g => {
                                 let isTrue = g.includes('\\True');
                                 let cleanText = g.replace(/\\True/g, '').trim();
                                 return { text: cleanText, answer: isTrue };
                             });
                             questions.push({ id: globalQIndex++, part: 2, type: 'tf', text: textPart, statements: statements });
                         }
                     } else if (choiceMatch) {
                         let keywordIdx = choiceMatch.index;
                         let textPart = qContent.substring(0, keywordIdx).trim();
                         let groups = extractBraceGroups(qContent, keywordIdx, 4);
                         
                         if (groups.length === 4) {
                             let answerIdx = -1;
                             let options = groups.map((g, idx) => {
                                 if (g.includes('\\True')) answerIdx = idx;
                                 return g.replace(/\\True/g, '').trim();
                             });
                             if (answerIdx !== -1) {
                                 questions.push({ id: globalQIndex++, part: 1, type: 'mcq', text: textPart, options: options, answer: answerIdx });
                             }
                         }
                     } else {
                         let ansRegex = /\\shortanswer\{([^}]+)\}/i;
                         let ansMatch = blockContent.match(ansRegex);
                         let answer = ansMatch ? ansMatch[1].trim() : "";
                         questions.push({ id: globalQIndex++, part: 3, type: 'sa', text: qContent.trim(), answer: answer });
                     }
                 }
             }
             return questions;
        }

