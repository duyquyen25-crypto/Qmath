            els.questionText.innerHTML = `<div class="text-xs font-bold text-blue-600 mb-2 uppercase tracking-wider bg-blue-50 px-2.5 py-1 rounded inline-block border border-blue-200">${partTitle}</div><div class="mt-2 font-medium">${formattedText}</div>`;
            els.optionsContainer.innerHTML = '';
            
            // TYPE 1: MCQ
            if (q.type === 'mcq') {
                q.options.forEach((optText, index) => {
                    const optId = `opt_${index}`;
                    const wrapper = document.createElement('div');
                    wrapper.className = 'relative flex items-center mb-2';
                    
                    const input = document.createElement('input');
                    input.type = 'radio';
                    input.name = 'quiz_option';
                    input.id = optId;
                    input.value = index;
                    input.className = 'hidden';
                    
                    if (userAnswers[currentQuestionIndex] === index) input.checked = true;

                    input.addEventListener('change', (e) => {
                        userAnswers[currentQuestionIndex] = parseInt(e.target.value);
                        updateNavigationButtons();
                    });

                    const label = document.createElement('label');
                    label.htmlFor = optId;
                    label.className = 'option-label flex-1 border border-gray-300 rounded-lg p-3 text-gray-800 bg-white shadow-sm font-medium flex items-center';
                    label.innerHTML = `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-gray-100 mr-3 text-xs font-bold text-gray-600 shrink-0">${String.fromCharCode(65 + index)}</span> <span>${formatLatexContent(optText)}</span>`;

                    wrapper.appendChild(input);
                    wrapper.appendChild(label);
                    els.optionsContainer.appendChild(wrapper);
                });
            } 
            
            // TYPE 2: True / False
            else if (q.type === 'tf') {
                const tableContainer = document.createElement('div');
                tableContainer.className = "flex flex-col gap-3 mt-4";
                
                (q.statements || []).forEach((stmt, sIdx) => {
                    const wrapper = document.createElement('div');
                    wrapper.className = "flex flex-col sm:flex-row sm:items-center justify-between p-3.5 bg-gray-50 border rounded-lg gap-2";
                    
                    const textSpan = document.createElement('div');
                    textSpan.className = "text-gray-800 font-medium flex-1 text-sm sm:text-base";
                    textSpan.innerHTML = `<span class="font-bold text-blue-600 mr-1.5">${String.fromCharCode(97 + sIdx)})</span> ${formatLatexContent(stmt.text)}`;
                    
                    const btnGroup = document.createElement('div');
                    btnGroup.className = "flex gap-2 shrink-0 self-end sm:self-auto";
                    
                    const trueBtn = document.createElement('label');
                    trueBtn.className = `px-3.5 py-1.5 rounded text-sm font-medium border cursor-pointer transition ${userAnswers[currentQuestionIndex][sIdx] === true ? 'bg-green-600 text-white border-green-600' : 'bg-white hover:bg-gray-100 text-gray-700'}`;
                    trueBtn.innerHTML = `<input type="radio" name="tf_${sIdx}" class="hidden" value="true"> Đúng`;
                    
                    const falseBtn = document.createElement('label');
                    falseBtn.className = `px-3.5 py-1.5 rounded text-sm font-medium border cursor-pointer transition ${userAnswers[currentQuestionIndex][sIdx] === false ? 'bg-red-600 text-white border-red-600' : 'bg-white hover:bg-gray-100 text-gray-700'}`;
                    falseBtn.innerHTML = `<input type="radio" name="tf_${sIdx}" class="hidden" value="false"> Sai`;

                    const updateTF = (val) => {
                        userAnswers[currentQuestionIndex][sIdx] = val;
