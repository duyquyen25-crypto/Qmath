        function loadTeacherData() {
            if(!db) return;
            const resultsRef = collection(db, 'artifacts', appId, 'public', 'data', 'quiz_results');
            
            teacherUnsubscribe = onSnapshot(resultsRef, (snapshot) => {
                allResultsData = [];
                snapshot.forEach(doc => {
                    const data = doc.data();
                    const time = data.timestamp ? data.timestamp.toDate() : new Date(data.localTime || Date.now());
                    allResultsData.push({ id: doc.id, ...data, timeDate: time });
                });
                
                processTeacherStats(allResultsData);
            }, (error) => {
                console.error("Teacher snapshot error:", error);
                showError("Không thể tải bảng điểm học sinh.");
            });
        }

        function processTeacherStats(results) {
            const studentMap = new Map();
            let totalAttempts = results.length;
            let sumScores = 0;

            results.forEach(record => {
                sumScores += record.score || 0;
                
                if (!studentMap.has(record.studentId)) {
                    studentMap.set(record.studentId, {
                        name: record.studentName,
                        className: record.className || 'N/A',
                        school: record.school || 'N/A',
                        attempts: 0,
                        highestScore: 0,
                        latestScore: 0,
                        maxCheatWarnings: 0,
                        latestTime: new Date(0)
                    });
                }
                
                const s = studentMap.get(record.studentId);
                s.attempts++;
                
                if(record.score > s.highestScore) s.highestScore = record.score;
                if((record.cheatWarnings || 0) > s.maxCheatWarnings) s.maxCheatWarnings = record.cheatWarnings;
                
                if(record.timeDate > s.latestTime) {
                    s.latestTime = record.timeDate;
                    s.latestScore = record.score;
                }
            });

            els.statTotalStudents.textContent = studentMap.size;
            els.statTotalAttempts.textContent = totalAttempts;
            
            const avg = totalAttempts > 0 ? (sumScores / totalAttempts).toFixed(1) : 0;
            els.statAvgScore.textContent = avg;

            renderTeacherTable(Array.from(studentMap.values()));
        }

        function renderTeacherTable(studentsArray) {
            els.studentsTableBody.innerHTML = '';
            
            if(studentsArray.length === 0) {
                els.studentsTableBody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-gray-500">Chưa có kết quả thi nào.</td></tr>`;
                return;
            }

            studentsArray.sort((a,b) => b.latestTime - a.latestTime);
            
            const searchTerm = els.searchInput.value.toLowerCase().trim();
            const filteredArray = studentsArray.filter(s => s.name.toLowerCase().includes(searchTerm));

            filteredArray.forEach(student => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-gray-50 transition border-b border-gray-100';
                
                const timeStr = student.latestTime.toLocaleString('vi-VN', { 
                    hour: '2-digit', minute:'2-digit', day: '2-digit', month: '2-digit'
                });

                tr.innerHTML = `
                    <td class="p-4"><div class="font-semibold text-gray-800">${student.name}</div></td>
                    <td class="p-4 text-sm text-gray-600">${student.school} <br/> <span class="font-medium text-gray-500">Lớp: ${student.className}</span></td>
                    <td class="p-4 text-center"><span class="bg-gray-100 text-gray-700 px-2 py-1 rounded-full text-xs font-semibold">${student.attempts}</span></td>
                    <td class="p-4 text-center"><span class="font-bold text-blue-600">${student.latestScore}</span> <span class="text-xs text-gray-400">/ 10</span></td>
                    <td class="p-4 text-center"><span class="font-bold text-green-600">${student.highestScore}</span> <span class="text-xs text-gray-400">/ 10</span></td>
                    <td class="p-4 text-center">${student.maxCheatWarnings > 0 ? `<span class="bg-red-100 text-red-700 px-2.5 py-1 rounded-full text-xs font-bold">${student.maxCheatWarnings} lần</span>` : `<span class="text-green-500"><i class="fas fa-check-circle"></i> An toàn</span>`}</td>
                    <td class="p-4 text-right text-xs text-gray-500 font-mono">${timeStr}</td>
                `;
                els.studentsTableBody.appendChild(tr);
            });
        }

        els.exportCsvBtn.addEventListener('click', () => {
            if (allResultsData.length === 0) {
                showError("Chưa có dữ liệu để xuất báo cáo!");
                return;
            }

            const studentMap = new Map();
            allResultsData.forEach(record => {
                 if (!studentMap.has(record.studentId)) {
                    studentMap.set(record.studentId, {
                        name: record.studentName, className: record.className || 'N/A', school: record.school || 'N/A',
                        attempts: 0, highestScore: 0, latestScore: 0, maxCheatWarnings: 0, latestTime: new Date(0)
                    });
                }
                const s = studentMap.get(record.studentId);
                s.attempts++;
                if(record.score > s.highestScore) s.highestScore = record.score;
                if((record.cheatWarnings || 0) > s.maxCheatWarnings) s.maxCheatWarnings = record.cheatWarnings;
                if(record.timeDate > s.latestTime) {
                    s.latestTime = record.timeDate;
                    s.latestScore = record.score;
                }
            });

            const dataToExport = Array.from(studentMap.values()).sort((a,b) => b.latestTime - a.latestTime);
            const headers = ["Họ và Tên", "Trường", "Lớp", "Số lần thi", "Điểm mới nhất", "Điểm cao nhất", "Số lần cảnh báo", "Thời gian nộp"];
            const csvRows = [headers.join(",")];
            
            dataToExport.forEach(s => {
                const timeStr = s.latestTime.toLocaleString('vi-VN');
                const row = [
                    `"${s.name}"`, `"${s.school}"`, `"${s.className}"`, 
                    s.attempts, s.latestScore, s.highestScore, 
                    s.maxCheatWarnings, `"${timeStr}"`
                ];
                csvRows.push(row.join(","));
            });

            const csvContent = "\uFEFF" + csvRows.join("\n");
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            
            link.setAttribute("href", url);
            link.setAttribute("download", `KetQuaThi_${new Date().getTime()}.csv`);
            link.style.visibility = 'hidden';
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        els.searchInput.addEventListener('input', () => {
             processTeacherStats(allResultsData);
        });
        
        els.refreshDataBtn.addEventListener('click', () => {
            const icon = els.refreshDataBtn.querySelector('i');
            icon.classList.add('fa-spin');
            if(db) loadTeacherData();
            setTimeout(() => {
                icon.classList.remove('fa-spin');
            }, 500);
        });

        function setupMockBehavior() {
            const localQuiz = localStorage.getItem('local_quiz_questions');
            if (localQuiz) {
                try {
                    QUIZ_QUESTIONS = JSON.parse(localQuiz);
                } catch (e) {
                    console.warn("Không thể tải đề thi từ LocalStorage.");
                }
            }
            showView('loginView');
        }

        async function initFirebase() {
            try {
                if (firebaseConfig && firebaseConfig.apiKey) {
                    app = initializeApp(firebaseConfig);
                    auth = getAuth(app);
                    db = getFirestore(app);
                    
                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }
                    
                    try {
                        const quizDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'global_quiz', 'current_quiz');
                        quizUnsubscribe = onSnapshot(quizDocRef, (quizSnap) => {
                            if (quizSnap.exists() && quizSnap.data().questions) {
                                QUIZ_QUESTIONS = quizSnap.data().questions;
                                // Cập nhật số lượng câu hỏi trên giao diện của học sinh nếu đang mở
                                if (els.totalQuestionsCount) {
                                    els.totalQuestionsCount.textContent = QUIZ_QUESTIONS.length;
                                }
                                console.log("Đã đồng bộ đề thi mới từ máy chủ.");
                            }
                        }, (err) => {
                            console.warn("Lỗi khi lắng nghe đề thi:", err);
                        });
                    } catch(e) {
                        console.log("Dùng câu hỏi mặc định:", e);
                    }
                } else {
                    setupMockBehavior();
                }
            } catch(err) {
                console.warn("Lỗi khởi tạo Firebase, chuyển chế độ ngoại tuyến:", err);
                setupMockBehavior();
            } finally {
                checkExistingSession();
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            initFirebase();
        });
    </script>
</body>
</html>
