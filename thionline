        function renderQuestion() {
            const q = SHUFFLED_QUESTIONS[currentQuestionIndex];
            els.currentQuestionNum.textContent = currentQuestionIndex + 1;
            els.totalQuestionsCount.textContent = SHUFFLED_QUESTIONS.length;
            
            let partTitle = "Phần I: Trắc nghiệm 4 lựa chọn";
            if (q.type === 'tf') partTitle = "Phần II: Trắc nghiệm Đúng / Sai";
            if (q.type === 'sa') partTitle = "Phần III: Trắc nghiệm Trả lời ngắn";
            
            // Format question text with Latex image and TikZ support
