        els.submitQuizBtn.addEventListener('click', async () => {
            stopAntiCheat();
            
            let totalPossiblePoints = 0;
            let earnedPoints = 0;

            SHUFFLED_QUESTIONS.forEach((q, index) => {
                const ans = userAnswers[index];
                
                if (q.type === 'mcq') {
                    totalPossiblePoints += 1;
                    if (ans === q.answer) earnedPoints += 1;
                } 
                else if (q.type === 'tf') {
                    totalPossiblePoints += 1; 
                    let correctSubStmts = 0;
                    (q.statements || []).forEach((stmt, sIdx) => {
                        if (ans && ans[sIdx] === stmt.answer) correctSubStmts++;
                    });
                    
                    if (correctSubStmts === 1) earnedPoints += 0.1;
                    else if (correctSubStmts === 2) earnedPoints += 0.25;
                    else if (correctSubStmts === 3) earnedPoints += 0.5;
                    else if (correctSubStmts === 4) earnedPoints += 1.0;
                }
                else if (q.type === 'sa') {
                    totalPossiblePoints += 1;
                    if (ans && q.answer && ans.toString().toLowerCase().replace(/\s/g,'') === q.answer.toString().toLowerCase().replace(/\s/g,'')) {
                        earnedPoints += 1;
                    }
                }
            });

            let finalScore = 0;
            if (totalPossiblePoints > 0) {
                 finalScore = Math.round(((earnedPoints / totalPossiblePoints) * 10) * 10) / 10;
            }
            
            els.activeQuizArea.classList.add('hidden');
            els.quizResultArea.classList.remove('hidden');
            els.finalScoreDisplay.textContent = finalScore;

