        function shuffleArray(array) {
            let currentIndex = array.length, randomIndex;
            let tempArray = [...array];
            while (currentIndex != 0) {
                randomIndex = Math.floor(Math.random() * currentIndex);
                currentIndex--;
                [tempArray[currentIndex], tempArray[randomIndex]] = [tempArray[randomIndex], tempArray[currentIndex]];
            }
            return tempArray;
        }

        function prepareShuffledQuiz() {
            let part1 = QUIZ_QUESTIONS.filter(q => q.type === 'mcq' || q.part === 1 || (!q.type && !q.part));
            let part2 = QUIZ_QUESTIONS.filter(q => q.type === 'tf' || q.part === 2);
            let part3 = QUIZ_QUESTIONS.filter(q => q.type === 'sa' || q.part === 3);

            part1 = shuffleArray(part1).map(q => {
                let originalOptions = [...q.options];
                let originalAnswerText = originalOptions[q.answer];
                let shuffledOptions = shuffleArray(originalOptions);
                let newAnswerIndex = shuffledOptions.indexOf(originalAnswerText);
                return { ...q, type: 'mcq', options: shuffledOptions, answer: newAnswerIndex };
            });

            part2 = shuffleArray(part2).map(q => ({ ...q, type: 'tf' }));
            part3 = shuffleArray(part3).map(q => ({ ...q, type: 'sa' }));

            SHUFFLED_QUESTIONS = [...part1, ...part2, ...part3];

            userAnswers = SHUFFLED_QUESTIONS.map(q => {
                if (q.type === 'tf') return [null, null, null, null];
                if (q.type === 'sa') return "";
                return null;
            });
        }

