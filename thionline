        // Helper method to format LaTeX images (\includegraphics) & TikZ diagrams (\begin{tikzpicture}) into HTML
        function formatLatexContent(rawText) {
            if (!rawText) return '';
            let text = rawText;

            // 1. Convert LaTeX center environment \begin{center}...\end{center}
            text = text.replace(/\\begin\{center\}([\s\S]*?)\\end\{center\}/gi, '<div class="text-center my-3">$1</div>');

            // 2. Convert \includegraphics[options]{path/url} or \includegraphics{path/url}
            text = text.replace(/\\includegraphics(?:\[.*?\])?\{([^}]+)\}/gi, (match, src) => {
                const cleanSrc = src.trim();
                return `<div class="my-3 text-center flex flex-col items-center justify-center">
                    <img src="${cleanSrc}" alt="Hình vẽ LaTeX" class="max-w-full max-h-80 rounded-lg shadow-md border border-gray-200 object-contain my-1" 
                    onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\\'p-2 text-xs text-red-600 bg-red-50 border border-red-200 rounded my-1 inline-flex items-center gap-1.5\\'><i class=\\'fas fa-image\\'></i> Không tải được ảnh: <code>${cleanSrc}</code></div>';" />
                </div>`;
            });

            // 3. Convert \begin{tikzpicture} ... \end{tikzpicture} for TikZJax
            text = text.replace(/\\begin\{tikzpicture\}([\s\S]*?)\\end\{tikzpicture\}/gi, (match, code) => {
                return `<div class="my-3 text-center overflow-x-auto flex justify-center tikz-container bg-white p-2 border border-gray-100 rounded-lg shadow-sm"><script type="text/tikz">\\begin{tikzpicture}${code}\\end{tikzpicture}<\/script></div>`;
            });

            // 4. Line breaks
            text = text.replace(/\n/g, '<br/>');

            return text;
        }

