<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ Thống Thi Trực Tuyến</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <!-- MathJax Configuration for LaTeX Math Formatting -->
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']],
                processEscapes: true
            },
            svg: { fontCache: 'global' }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    
    <!-- TikZJax Support for rendering LaTeX TikZ diagrams -->
    <link rel="stylesheet" href="https://tikzjax.com/v1/tikzjax.css">
    <script src="https://tikzjax.com/v1/tikzjax.js" async></script>

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
        .hidden { display: none !important; }
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .option-label { transition: all 0.2s ease-in-out; }
        .option-label:hover { background-color: #f3f4f6; cursor: pointer; }
        input[type="radio"]:checked + .option-label {
            background-color: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }
        .table-container::-webkit-scrollbar { height: 8px; width: 8px; }
        .table-container::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        .table-container::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 4px; }
        .table-container::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }
        .user-select-none {
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }
        /* Style adjustments for TikZ SVGs */
        .tikz-container svg {
            max-width: 100% !important;
            height: auto !important;
            margin: 0 auto;
        }
    </style>
</head>
<body class="min-h-screen text-gray-800 antialiased flex flex-col user-select-none">

    <header class="bg-blue-600 text-white shadow-md p-4 sticky top-0 z-10">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-xl md:text-2xl font-bold flex items-center gap-2">
                <i class="fas fa-graduation-cap"></i> Hệ Thống Thi Trực Tuyến
            </h1>
            <div id="userInfo" class="hidden flex items-center gap-4">
                <span id="userNameDisplay" class="font-medium"></span>
                <span id="userRoleBadge" class="px-2 py-1 bg-blue-500 rounded text-xs font-semibold uppercase"></span>
                <button id="logoutBtn" class="bg-white text-blue-600 hover:bg-gray-100 px-3 py-1 rounded shadow text-sm font-medium transition">
                    Đăng xuất
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow container mx-auto p-4 md:p-6 flex justify-center items-start pt-8">
        
        <div id="loadingScreen" class="w-full flex flex-col items-center justify-center mt-20">
            <i class="fas fa-spinner fa-spin text-4xl text-blue-600 mb-4"></i>
            <p class="text-gray-600">Đang kết nối hệ thống...</p>
        </div>

        <!-- Login / Register View -->
        <div id="loginView" class="hidden w-full max-w-md glass-panel p-8 mt-6">
            <div class="flex border-b mb-6">
                <button id="tabLogin" class="w-1/2 py-2 font-bold text-center border-b-2 border-blue-600 text-blue-600 transition">
                    Đăng Nhập
                </button>
                <button id="tabRegister" class="w-1/2 py-2 font-bold text-center text-gray-500 hover:text-blue-600 transition">
                    Đăng Ký
                </button>
            </div>

            <div id="loginFormContainer" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Tên đăng nhập / Email</label>
                    <input type="text" id="loginUsername" placeholder="Nhập tên đăng nhập..." class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu</label>
                    <input type="password" id="loginPassword" placeholder="Nhập mật khẩu..." class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Bạn là?</label>
                    <select id="loginRole" class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                        <option value="student">Học sinh</option>
                        <option value="teacher">Giáo viên</option>
                    </select>
                </div>
                
                <div id="loginError" class="hidden text-red-500 text-sm mt-1">Vui lòng điền đầy đủ thông tin.</div>
                <button id="loginBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md transition mt-4">
                    Vào Hệ Thống
                </button>
            </div>

            <div id="registerFormContainer" class="hidden space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Họ và tên</label>
                    <input type="text" id="regName" placeholder="Ví dụ: Nguyễn Văn A" class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Tên đăng nhập / Email</label>
                    <input type="text" id="regUsername" placeholder="Tên tài khoản duy nhất..." class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu</label>
                    <input type="password" id="regPassword" placeholder="Tạo mật khẩu..." class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Vai trò</label>
                    <select id="regRole" class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                        <option value="student">Học sinh</option>
                        <option value="teacher">Giáo viên</option>
                    </select>
                </div>

                <div id="regStudentFields" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Lớp</label>
                        <input type="text" id="regClass" placeholder="Ví dụ: 12A1" class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Trường</label>
                        <input type="text" id="regSchool" placeholder="Tên trường THPT..." class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                    </div>
                </div>

                <div id="regTeacherFields" class="hidden space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Bộ môn giảng dạy</label>
                        <input type="text" id="regSubject" placeholder="Ví dụ: Toán học, Vật lý..." class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
                    </div>
                </div>

                <div id="regError" class="hidden text-red-500 text-sm mt-1">Vui lòng điền đầy đủ thông tin.</div>
                <button id="registerBtn" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-md transition mt-4">
                    Đăng Ký Tài Khoản
                </button>
            </div>
        </div>

        <div id="studentDashboard" class="hidden w-full max-w-3xl space-y-6">
            <div class="glass-panel p-6 flex flex-col sm:flex-row justify-between items-center gap-4 bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-100">
                <div>
                    <h3 class="text-lg font-semibold text-blue-800">Xin chào, <span id="studentGreetingName"></span>!</h3>
                    <p class="text-sm text-gray-600">Sẵn sàng thực hiện bài thi kiểm tra kiến thức?</p>
                </div>
                <div class="flex gap-4 text-center">
                    <div class="bg-white p-3 rounded-lg shadow-sm border border-gray-100 min-w-[80px]">
                        <div class="text-xs text-gray-500 uppercase tracking-wide">Số lần thi</div>
                        <div id="studentAttemptCount" class="text-xl font-bold text-blue-600">0</div>
                    </div>
                    <div class="bg-white p-3 rounded-lg shadow-sm border border-gray-100 min-w-[80px]">
                        <div class="text-xs text-gray-500 uppercase tracking-wide">Điểm cao nhất</div>
                        <div id="studentHighScore" class="text-xl font-bold text-green-600">0</div>
                    </div>
                </div>
            </div>

            <div id="quizIntro" class="glass-panel p-6">
                <h3 class="text-xl font-bold mb-4 border-b pb-2 text-gray-800">Bài Kiểm Tra Trắc Nghiệm Tự Động</h3>
                <p class="text-gray-600 mb-4">Đề thi hỗ trợ công thức Toán LaTeX, hình vẽ <code>\includegraphics</code>, sơ đồ TikZ, câu hỏi Đúng/Sai và Trả lời ngắn. Mọi thao tác đều được giám sát tự động.</p>
                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 mb-6">
                    <div class="flex items-center gap-1.5"><i class="far fa-clock text-blue-500"></i> Giám sát thời gian thực</div>
                    <div class="flex items-center gap-1.5"><i class="fas fa-shield-alt text-red-500"></i> Cảnh báo tối đa 3 lần</div>
                    <div class="flex items-center gap-1.5"><i class="fas fa-image text-green-500"></i> Hỗ trợ hình vẽ LaTeX / TikZ</div>
                </div>
                <button id="startQuizBtn" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 px-6 rounded-md shadow transition flex items-center gap-2">
                    <i class="fas fa-play"></i> Bắt đầu làm bài
                </button>
            </div>

            <div id="activeQuizArea" class="hidden glass-panel p-6">
                <div class="flex justify-between items-center mb-6 border-b pb-4">
                    <h3 class="text-xl font-bold text-blue-700">Đang làm bài thi...</h3>
                    <div class="text-sm font-semibold bg-blue-100 text-blue-800 px-3 py-1 rounded-full">
                        Câu <span id="currentQuestionNum">1</span> / <span id="totalQuestionsCount">5</span>
                    </div>
                </div>
                
                <div id="questionContainer" class="mb-8">
                    <div id="questionText" class="text-lg font-medium mb-4 text-gray-800 leading-relaxed">Nội dung câu hỏi...</div>
                    <div id="optionsContainer" class="space-y-3"></div>
                </div>

                <div class="flex justify-between items-center mt-6 pt-4 border-t">
                    <button id="prevBtn" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-md transition disabled:opacity-50 disabled:cursor-not-allowed font-medium">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </button>
                    <button id="nextBtn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition font-medium">
                        Tiếp theo <i class="fas fa-arrow-right ml-1"></i>
                    </button>
                    <button id="submitQuizBtn" class="hidden px-5 py-2 bg-green-600 hover:bg-green-700 text-white font-bold rounded-md shadow-md transition">
                        <i class="fas fa-paper-plane mr-1"></i> Nộp Bài
                    </button>
                </div>
            </div>

            <div id="quizResultArea" class="hidden glass-panel p-8 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 mb-4">
                    <i class="fas fa-check text-3xl text-green-500"></i>
                </div>
                <h2 class="text-2xl font-bold mb-2 text-gray-800">Đã nộp bài thành công!</h2>
                <p class="text-gray-600 mb-6">Bạn đã hoàn thành xong bài thi kiểm tra.</p>
                
                <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6 inline-block min-w-[220px]">
                    <div class="text-xs font-semibold uppercase tracking-wider text-blue-600 mb-1">Điểm số của bạn</div>
                    <div class="text-5xl font-black text-blue-700">
                        <span id="finalScoreDisplay">0</span> <span class="text-lg text-gray-500 font-normal">/ 10</span>
                    </div>
                </div>

                <div class="flex justify-center gap-3">
                    <button id="backToHomeBtn" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium py-2 px-5 rounded-md transition">Về trang chủ</button>
                    <button id="retakeQuizBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-5 rounded-md shadow transition">Thi lại</button>
                </div>
            </div>
        </div>

        <div id="teacherDashboard" class="hidden w-full max-w-5xl space-y-6">
            <div class="glass-panel p-6 bg-gradient-to-r from-purple-50 to-pink-50 border border-purple-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-purple-800 mb-1">Bảng Điều Khiển Giáo Viên</h2>
                    <p class="text-sm text-gray-600">Tải đề thi LaTeX/TXT (hỗ trợ TikZ & hình vẽ), kiểm tra chỉnh sửa đề và theo dõi bảng điểm học sinh toàn hệ thống.</p>
                </div>
                <div class="flex flex-wrap gap-2">
                     <button id="uploadQuizBtn" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md shadow-sm transition flex items-center gap-2 font-medium">
                        <i class="fas fa-upload"></i> Upload Đề Thi (.txt, .tex)
                    </button>
                    <input type="file" id="quizFileInput" accept=".txt,.tex" class="hidden">

                    <button id="editCurrentQuizBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md shadow-sm transition flex items-center gap-2 font-medium">
                        <i class="fas fa-edit"></i> Sửa Đề Hiện Tại
                    </button>
                    
                    <button id="exportCsvBtn" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md shadow-sm transition flex items-center gap-2 font-medium">
                        <i class="fas fa-file-csv"></i> Xuất CSV
                    </button>

                    <button id="refreshDataBtn" class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-md shadow-sm transition flex items-center gap-2 font-medium">
                        <i class="fas fa-sync-alt"></i> Làm mới
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="glass-panel p-5 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-xl">
                        <i class="fas fa-users"></i>
                    </div>
                    <div>
                        <div class="text-xs text-gray-500 font-semibold uppercase">Tổng Học Sinh Đã Thi</div>
                        <div id="statTotalStudents" class="text-2xl font-bold text-gray-800">0</div>
                    </div>
                </div>
                <div class="glass-panel p-5 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-600 text-xl">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div>
                        <div class="text-xs text-gray-500 font-semibold uppercase">Tổng Số Lượt Làm Bài</div>
                        <div id="statTotalAttempts" class="text-2xl font-bold text-gray-800">0</div>
                    </div>
                </div>
                <div class="glass-panel p-5 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600 text-xl">
                        <i class="fas fa-star"></i>
                    </div>
                    <div>
                        <div class="text-xs text-gray-500 font-semibold uppercase">Điểm Trung Bình</div>
                        <div id="statAvgScore" class="text-2xl font-bold text-gray-800">0.0</div>
                    </div>
                </div>
            </div>

            <div class="glass-panel overflow-hidden">
                <div class="p-4 bg-gray-50 border-b flex justify-between items-center">
                    <h3 class="font-bold text-gray-800">Danh Sách Kết Quả Học Sinh</h3>
                    <div class="relative">
                        <input type="text" id="searchInput" placeholder="Tìm kiếm tên học sinh..." class="pl-8 pr-4 py-1.5 border rounded-full text-sm focus:outline-none focus:ring-1 focus:ring-blue-500 w-48 sm:w-64">
                        <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 text-xs"></i>
                    </div>
                </div>
                <div class="table-container overflow-x-auto">
                    <table class="w-full text-left border-collapse whitespace-nowrap">
                        <thead>
                            <tr class="bg-gray-100 text-gray-600 text-xs uppercase tracking-wider border-b">
                                <th class="p-4 font-semibold">Họ và Tên</th>
                                <th class="p-4 font-semibold">Trường - Lớp</th>
                                <th class="p-4 font-semibold text-center">Số Lần Thi</th>
                                <th class="p-4 font-semibold text-center">Điểm Mới Nhất</th>
                                <th class="p-4 font-semibold text-center">Điểm Cao Nhất</th>
                                <th class="p-4 font-semibold text-center">Cảnh Báo Violate</th>
                                <th class="p-4 font-semibold text-right">Cập Nhật Gần Nhất</th>
                            </tr>
                        </thead>
                        <tbody id="studentsTableBody" class="divide-y divide-gray-200 text-sm">
                            <tr><td colspan="7" class="p-8 text-center text-gray-500">Đang tải dữ liệu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <div id="errorModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-[60]">
        <div class="bg-white rounded-lg p-6 max-w-sm w-full mx-4 shadow-xl">
            <h3 class="text-lg font-bold text-red-600 mb-2 flex items-center gap-2">
                <i class="fas fa-exclamation-triangle"></i> Thông báo
            </h3>
            <p id="errorMessage" class="text-gray-700 mb-4 text-sm"></p>
            <div class="text-right">
                <button onclick="document.getElementById('errorModal').classList.add('hidden')" class="bg-gray-200 hover:bg-gray-300 px-4 py-1.5 rounded text-gray-800 transition text-sm">Đóng</button>
            </div>
        </div>
    </div>

    <div id="cheatWarningModal" class="hidden fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-[70] backdrop-blur-sm">
        <div class="bg-white rounded-lg p-8 max-w-md w-full mx-4 shadow-2xl border-4 border-red-500 text-center">
            <i class="fas fa-triangle-exclamation text-5xl text-red-600 mb-4 animate-pulse"></i>
            <h3 class="text-2xl font-black text-red-600 mb-2 uppercase">Cảnh báo gian lận!</h3>
            <p id="cheatWarningMessage" class="text-gray-800 text-base mb-6 font-medium"></p>
            <button onclick="document.getElementById('cheatWarningModal').classList.add('hidden')" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded transition">Tôi đã hiểu</button>
        </div>
    </div>

    <div id="quizEditorModal" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-[80] p-3 sm:p-6 overflow-y-auto backdrop-blur-sm">
        <div class="bg-white rounded-xl shadow-2xl max-w-4xl w-full max-h-[90vh] flex flex-col overflow-hidden border border-gray-200">
            <!-- Modal Header -->
            <div class="p-4 sm:p-5 bg-gradient-to-r from-indigo-700 to-purple-700 text-white flex justify-between items-center shrink-0">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-white/20 rounded-lg"><i class="fas fa-file-signature text-xl"></i></div>
                    <div>
                        <h3 class="text-lg sm:text-xl font-bold">Kiểm Tra & Chỉnh Sửa Đề Thi</h3>
                        <p class="text-xs text-indigo-100">Kiểm tra danh sách câu hỏi, hình vẽ, TikZ, điều chỉnh đáp án trước khi xuất bản.</p>
                    </div>
                </div>
                <button id="closeEditorBtn" class="text-white hover:bg-white/20 rounded-full w-8 h-8 flex items-center justify-center transition">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>

            <!-- Modal Sub-bar Controls -->
            <div class="bg-gray-50 border-b p-3 px-6 flex flex-wrap justify-between items-center gap-3 shrink-0">
                <div class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                    <span>Tổng số câu hỏi:</span>
                    <span id="editorQuestionCount" class="bg-indigo-100 text-indigo-800 px-2.5 py-0.5 rounded-full font-bold text-xs">0</span>
                </div>
                <div class="flex items-center gap-2">
                    <button id="addEditorQuestionBtn" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold px-3 py-1.5 rounded-md border border-indigo-200 text-sm transition flex items-center gap-1.5">
                        <i class="fas fa-plus-circle"></i> Thêm câu hỏi
                    </button>
                    <button id="renderMathEditorBtn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold px-3 py-1.5 rounded-md border text-sm transition flex items-center gap-1.5">
                        <i class="fas fa-square-root-variable"></i> Xem công thức & Hình vẽ
                    </button>
                </div>
            </div>

            <!-- Scrollable Questions Container -->
            <div id="editorQuestionsList" class="p-4 sm:p-6 overflow-y-auto flex-grow space-y-6 bg-gray-100/60">
                <!-- Dynamically populated question cards -->
            </div>

            <!-- Modal Footer -->
            <div class="p-4 border-t bg-white flex justify-end gap-3 shrink-0">
                <button id="cancelEditorBtn" class="px-5 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-md font-medium text-sm transition">
                    Hủy bỏ
                </button>
